# Database
DATABASE_URL="file:./dev.db?connection_limit=1"

# JWT
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="8h"

# App
APP_URL="http://localhost:3000"
APP_PORT=3000

# Cashier PIN length
PIN_LENGTH=4

# Session timeout (minutes)
SESSION_TIMEOUT=30

# Currency
DEFAULT_CURRENCY="LKR"
CURRENCY_SYMBOL="Rs"
DECIMAL_PLACES=2

# Receipt settings
RECEIPT_HEADER="Local Grocery Store"
RECEIPT_FOOTER="Thank you for shopping!"
RECEIPT_WIDTH_MM=58

# Tax
DEFAULT_TAX_RATE=0.0
TAX_INCLUDED_IN_PRICES=true

# Low stock
DEFAULT_REORDER_LEVEL=10
LOW_STOCK_ALERT_DAYS=7

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24